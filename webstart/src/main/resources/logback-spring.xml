<?xml version="1.0" encoding="UTF-8"?>
<configuration>

	<!-- <property name="LOG_DIR" value="E:/pccsoft12Springboot" /> -->
	
	<!-- ค่า default: ถ้ารันใน tomcat จะเขียนลง [tomcat_install_dir]/logs ถ้าไม่ใช่จะเขียนลง ./logs -->
	<property name="DEFAULT_LOG_DIR" value="${catalina.home:-.}/logs" />

	<!-- ดึงค่า myLogPath จาก Spring Environment: ใช้ได้ทั้ง vm argument -DmyLogPath=...
	     และ myLogPath=... ใน application.properties ถ้าไม่ได้กำหนดจะใช้ DEFAULT_LOG_DIR -->
	<springProperty scope="context" name="LOG_DIR" source="myLogPath" defaultValue="${DEFAULT_LOG_DIR}" />


	<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<!-- <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n </pattern> -->
			<pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n </pattern>
		</encoder>
	</appender>
	
	<appender name="ROLLING" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${LOG_DIR}/pccsoft.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<fileNamePattern>${LOG_DIR}/pccsoft.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
			<!-- เก่าเกิน 30 วันให้ลบ -->
			<maxHistory>30</maxHistory>
		</rollingPolicy>
		<encoder>
			<pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
		</encoder>
	</appender>
	
<!-- <appender name="FILE" class="ch.qos.logback.core.FileAppender">
		<file>./my-application.log</file>
		<encoder>
			<pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
		</encoder>
	</appender> -->	
	
	<!-- trace, debug, info, warn, error -->
	<root level="info">
		<appender-ref ref="CONSOLE" />
		<appender-ref ref="ROLLING" />
		<!-- <appender-ref ref="FILE" />  -->
	</root>

</configuration>
